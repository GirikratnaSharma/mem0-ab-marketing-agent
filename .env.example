# Copy to .env and fill in. Get a key at https://app.mem0.ai/
# Without it the dashboard uses a local JSON fallback.
MEM0_API_KEY=your-mem0-api-key
# LLM that writes the A/B copy from recalled Mem0 context (llm.py). First one set wins: Ollama, Kimi, Claude.
# Free local option: install Ollama, `ollama pull qwen3:8b`, then set OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
